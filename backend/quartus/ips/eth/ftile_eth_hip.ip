          <ipxact:description>&lt;b&gt; Indicates DL measurement values in fixed-point format for TX datapath latency (in sampling_clk cycle). Must be qualified with tx_measure_valid. &lt;/b&gt;&lt;p&gt;Indicates DL measurement values in fixed-point format for TX datapath latency (in sampling_clk cycle). Must be qualified with tx_measure_valid.&lt;/p&gt;</ipxact:description>
          <ipxact:addressOffset>0x3f4</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-only</ipxact:access>
          <ipxact:field>
            <ipxact:name>tx_dl_delay_8L</ipxact:name>
            <ipxact:description>&lt;b&gt; Indicates DL measurement values in fixed-point format for TX datapath latency (in sampling_clk cycle). Must be qualified with tx_measure_valid. &lt;/b&gt;&lt;p&gt;Indicates DL measurement values in fixed-point format for TX datapath latency (in sampling_clk cycle). Must be qualified with tx_measure_valid.&lt;/p&gt;</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00000000</ipxact:value>
                <ipxact:mask>0xffffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>32</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>rx_dl_delay_8L</ipxact:name>
          <ipxact:description>&lt;b&gt; Indicates DL measurement values in fixed-point format for TX datapath latency (in sampling_clk cycle). Must be qualified with tx_measure_valid. &lt;/b&gt;&lt;p&gt;Indicates DL measurement values in fixed-point format for TX datapath latency (in sampling_clk cycle). Must be qualified with tx_measure_valid.&lt;/p&gt;</ipxact:description>
          <ipxact:addressOffset>0x3f8</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-only</ipxact:access>
          <ipxact:field>
            <ipxact:name>rx_dl_delay_8L</ipxact:name>
            <ipxact:description>&lt;b&gt; Indicates DL measurement values in fixed-point format for TX datapath latency (in sampling_clk cycle). Must be qualified with tx_measure_valid. &lt;/b&gt;&lt;p&gt;Indicates DL measurement values in fixed-point format for TX datapath latency (in sampling_clk cycle). Must be qualified with tx_measure_valid.&lt;/p&gt;</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00000000</ipxact:value>
                <ipxact:mask>0xffffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>32</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>dl_status_8L</ipxact:name>
          <ipxact:description>&lt;b&gt; Deterministic Latency Configuration &lt;/b&gt;&lt;p&gt;Deterministic Latency Configuration&lt;/p&gt;</ipxact:description>
          <ipxact:addressOffset>0x3fc</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-only</ipxact:access>
          <ipxact:field>
            <ipxact:name>tx_sync_valid</ipxact:name>
            <ipxact:description>&lt;b&gt; Issues a reset to allow TX deterministic latency (DL) measurements to be retaken. - 0: Reset disabled  - 1: Reset enabled.&lt;/b&gt;&lt;p&gt;Issues a reset to allow TX deterministic latency (DL) measurements to be retaken.  - 0: Reset disabled   - 1: Reset enabled.&lt;/p&gt;</ipxact:description>
            <ipxact:bitOffset>3</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>tx_async_valid</ipxact:name>
            <ipxact:description>&lt;b&gt; Issues a reset to allow RX deterministic latency (DL) measurements to be retaken. - 0: Reset disabled   - 1: Reset enabled.&lt;/b&gt;&lt;p&gt;Issues a reset to allow RX deterministic latency (DL) measurements to be retaken. - 0: Reset disabled   - 1: Reset enabled.&lt;/p&gt;</ipxact:description>
            <ipxact:bitOffset>2</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>rx_sync_valid</ipxact:name>
            <ipxact:description>&lt;b&gt; Indicates whether the TX deterministic latency (DL) measurement values are valid - 0: Invalid ; 1: Valid. &lt;/b&gt;&lt;p&gt;Indicates whether the TX deterministic latency (DL) measurement values are valid - 0: Invalid ; 1: Valid.&lt;/p&gt;</ipxact:description>
            <ipxact:bitOffset>1</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
          <ipxact:field>
            <ipxact:name>rx_async_valid</ipxact:name>
            <ipxact:description>&lt;b&gt; Indicates whether RX asynchronous counter values are valid: - 0: Invalid - 1: Valid&lt;/b&gt;&lt;p&gt;Indicates whether the RX deterministic latency (DL) measurement values are valid - 0: Invalid ; 1: Valid. Note: If block_lock is deasserted, this register is deasserted.&lt;/p&gt;</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x0</ipxact:value>
                <ipxact:mask>0x1</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>1</ipxact:bitWidth>
            <ipxact:access>read-only</ipxact:access>
          </ipxact:field>
        </ipxact:register>
        <ipxact:register>
          <ipxact:name>cwbin_control_register</ipxact:name>
          <ipxact:description>&lt;b&gt; Soft cwbin control register &lt;/b&gt;&lt;p&gt;1 : resets the cwbin module &lt;/p&gt;</ipxact:description>
          <ipxact:addressOffset>0x400</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-write</ipxact:access>
          <ipxact:field>
            <ipxact:name>cwbin_control_register</ipxact:name>
