              </ipxact:field>
              <ipxact:field>
                <ipxact:name>cwbin6_stat</ipxact:name>
                <ipxact:description>Statistics value 6 Error.</ipxact:description>
                <ipxact:bitOffset>16</ipxact:bitOffset>
                <ipxact:resets>
