            <ipxact:register>
              <ipxact:name>rsfec_corr_syms_cnt_lo</ipxact:name>
              <ipxact:description>RSFEC number of 10b symbols corrected for the FEC lane (low word: bits 31 to 0).&lt;br&gt;
