            <ipxact:description>RSFEC per lane custom AM configuration part 1</ipxact:description>
            <ipxact:addressOffset>0x1ecc</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
