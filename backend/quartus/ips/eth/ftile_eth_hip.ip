            <ipxact:name>SERDES_LANE_DSP_ADAPT_DSP_ADAPT_REG2PROBE</ipxact:name>
            <ipxact:displayName>DSP_ADAPT_REG2PROBE</ipxact:displayName>
            <ipxact:description>Reg2Probe Control Register for Section DSP_ADAPT
                The Reg2Probe Control Register can be used to enable/disable
                the Reg2Probe feature, and set the Reg2Probe address value.</ipxact:description>
