            <ipxact:name>SERDES_SHIM_CPU_PM_CPU_PM_REG2PROBE</ipxact:name>
            <ipxact:displayName>CPU_PM_REG2PROBE</ipxact:displayName>
            <ipxact:description>Reg2Probe Control Register for Section CPU_PM
                The Reg2Probe Control Register can be used to enable/disable
                the Reg2Probe feature, and set the Reg2Probe address value.</ipxact:description>
