            <ipxact:displayName>AN_REG2PROBE_CTRL</ipxact:displayName>
            <ipxact:description>Reg2Probe Control Register for Section AN
                The Reg2Probe Control Register can be used to enable/disable
                the Reg2Probe feature, and set the Reg2Probe address value</ipxact:description>
            <ipxact:addressOffset>0x0</ipxact:addressOffset>
