          <ipxact:addressOffset>0x408</ipxact:addressOffset>
          <ipxact:size>32</ipxact:size>
          <ipxact:access>read-only</ipxact:access>
          <ipxact:field>
            <ipxact:name>cwbin1_A</ipxact:name>
            <ipxact:description>&lt;b&gt; cwbin1_A &lt;/b&gt;&lt;p&gt;Hard IP rsfec_corr_cwbin_cnt_0_3 - cwbin 1 Errors are accumulated to 32 bit counter Block A&lt;/p&gt;</ipxact:description>
            <ipxact:bitOffset>0</ipxact:bitOffset>
            <ipxact:resets>
              <ipxact:reset>
                <ipxact:value>0x00000000</ipxact:value>
                <ipxact:mask>0xffffffff</ipxact:mask>
              </ipxact:reset>
            </ipxact:resets>
            <ipxact:bitWidth>32</ipxact:bitWidth>
