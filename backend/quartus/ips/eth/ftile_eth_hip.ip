          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_RX_CL136_BIT_ERROR_CNT</ipxact:name>
            <ipxact:displayName>TFL_RX_CL136_BIT_ERROR_CNT</ipxact:displayName>
            <ipxact:description>TFL RX Clause 136 PRBS bit error counter</ipxact:description>
            <ipxact:addressOffset>0x6c</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_TX_CL136_GENERAL_1</ipxact:name>
            <ipxact:displayName>TFL_TX_CL136_GENERAL_1</ipxact:displayName>
            <ipxact:description>SERDES_SHIM_TFL::TFL_TX_CL136_GENERAL_1</ipxact:description>
            <ipxact:addressOffset>0x70</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_RX_CL136_BER_CNT</ipxact:name>
            <ipxact:displayName>TFL_RX_CL136_BER_CNT</ipxact:displayName>
            <ipxact:description>SERDES_SHIM_TFL::TFL_RX_CL136_BER_CNT</ipxact:description>
            <ipxact:addressOffset>0x74</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_RX_CL136_BER_FRAME_CNT</ipxact:name>
            <ipxact:displayName>TFL_RX_CL136_BER_FRAME_CNT</ipxact:displayName>
            <ipxact:description>SERDES_SHIM_TFL::TFL_RX_CL136_BER_FRAME_CNT</ipxact:description>
            <ipxact:addressOffset>0x78</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_RX_CL72_BER_CNT</ipxact:name>
            <ipxact:displayName>TFL_RX_CL72_BER_CNT</ipxact:displayName>
            <ipxact:description>SERDES_SHIM_TFL::TFL_RX_CL72_BER_CNT</ipxact:description>
            <ipxact:addressOffset>0x7c</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_RX_CL72_BER_FRAME_CNT</ipxact:name>
            <ipxact:displayName>TFL_RX_CL72_BER_FRAME_CNT</ipxact:displayName>
            <ipxact:description>SERDES_SHIM_TFL::TFL_RX_CL72_BER_FRAME_CNT</ipxact:description>
            <ipxact:addressOffset>0x80</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_GENERAL_RO</ipxact:name>
            <ipxact:displayName>TFL_GENERAL_RO</ipxact:displayName>
            <ipxact:description>SERDES_SHIM_TFL::TFL_GENERAL_RO</ipxact:description>
            <ipxact:addressOffset>0x84</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_RX_CL136_GOOD_FRAME_CNT</ipxact:name>
            <ipxact:displayName>TFL_RX_CL136_GOOD_FRAME_CNT</ipxact:displayName>
            <ipxact:description>TFL RX Clause 136 good frames counter</ipxact:description>
            <ipxact:addressOffset>0x88</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_GENERAL</ipxact:name>
            <ipxact:displayName>TFL_GENERAL</ipxact:displayName>
            <ipxact:description>TFL General</ipxact:description>
            <ipxact:addressOffset>0x8c</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_TX_GB_CFG</ipxact:name>
            <ipxact:displayName>TFL_TX_GB_CFG</ipxact:displayName>
            <ipxact:description>SERDES_SHIM_TFL::TFL_TX_GB_CFG</ipxact:description>
            <ipxact:addressOffset>0x90</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
        </ipxact:registerFile>
        <ipxact:registerFile>
          <ipxact:name>SERDES_SHIM_TFL_lane3</ipxact:name>
          <ipxact:addressOffset>0x64000</ipxact:addressOffset>
          <ipxact:range>0x94</ipxact:range>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_ACCESS_CTRL</ipxact:name>
            <ipxact:displayName>TFL_ACCESS_CTRL</ipxact:displayName>
            <ipxact:description>Access Control Register for Section TFL
                The Access Control Register can be used to enable/disable and configure         
                the following access features to the Section registers:                         
                  + Soft Reset             -  Reset all RW Section's Registers (except this one)
                                              to their reset (default) values                   
                  + Load Preset Value      -  Load predefined Preset Value to selected Fields   
                  + Broadcast Mode         -  Enable/disable broadcast write mode               
                  + Field Mask Write (FMW) -  Enable/Disable Field Mask Write feature           
                  + Write Delay            -  Set delay (clock cycles) for write access         
                  + Read Delay             -  Set delay (clock cycles) for read access          
                  + Self-Clear Delay       -  Disable or set delay (clock cycles)               
                                              of Self-Clear/Set action (affect RWSC/RWSS Fields)
                  + Manual Self-Clear      -  Manually Clear/Set RWSC/RWSS Fields               
                  + Clear On Read Delay    -  Disable or set delay (clock cycles)               
                                              of Clear/Set On Read action                       
                                              (affect RWC/RWS/ROLH/ROLL Fields)                 
                  + Manual Clear On Read   -  Manually Clear/Set RWC/RWS/ROLH/ROLL Fields</ipxact:description>
            <ipxact:addressOffset>0x0</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_soft_reset_n</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_soft_reset_n [0:0]</ipxact:displayName>
              <ipxact:description>Soft Reset - Reset all Registers to their Reset Value (active low)
                    Reset all Section's RW Registers (except the Access Control register)
                    to their reset (default) values.
                    NOTE: Hard Reset will reset this bit to 1
                    .</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x1</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_load_preset</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_load_preset [1:1]</ipxact:displayName>
              <ipxact:description>Load Preset - Load predefined value to selected RW Registers Fields
                    Write RW Registers Fields which have predefined Preset values.
                    NOTE: Loading preset value is not considered as Write Access
                          to the written Registers.
                    .</ipxact:description>
              <ipxact:bitOffset>1</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_broadcast_mode</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_broadcast_mode [2:2]</ipxact:displayName>
              <ipxact:description>Broadcast Mode - Enable/Disable Broadcast Write mode
                    When Broadcast Mode is enabled, Write access to a Broadcast Master Register
                    will execute Write Access with the same write data
                    to all the Registers that in its Broadcast List.
                    .</ipxact:description>
              <ipxact:bitOffset>2</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x1</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_field_mask_write_en</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_field_mask_write_en [3:3]</ipxact:displayName>
              <ipxact:description>Field Mask Write - Enable/Disable Field Mask Write feature (FMW)
                    When FMW is enabled, the Write Data includes the encoding for generating
                    the FMW Data and FMW Mask buses, which are used (with the Read Data bus)
                    to form the final write data to the Registers.
                    The encoding format is selected by the Address bits [23:21]:
                    +----------------+---------+-------------------------------------------+
                    |                | Field's |                                           |
                    | Address[23:21] |  Width  | Write Data Bits Encoding                  |
                    |                |  Range  |                                           |
                    |----------------|---------|-------------------------------------------|
                    |     0   Bypass |   32    |  [31:0] = Value to write (no mask)        |
                    |----------------|---------|-------------------------------------------|
                    |                |         |  [21:0] = Value to write                  |
                    |     1          |  1 - 22 | [26:22] = Field's offset                  |
                    |                |         | [31:27] = Number of 1's in Mask's msb (*) |
                    |----------------|---------|-------------------------------------------|
                    |                |         |  [25:0] = Value to write                  |
                    |     2          | 23 - 26 | [27:26] = Field's width                   |
                    |                |         |           0=23,  1=24,  2=25,  3=26       |
                    |                |         | [31:28] = Field's offset                  |
                    |----------------|---------|-------------------------------------------|
                    |                |         |  [27:0] = Value to write                  |
                    |     3          | 27 - 28 |    [28] = Field's width                   |
                    |                |         |           0=27,  1=28                     |
                    |                |         | [31:29] = Field's offset                  |
                    |----------------|---------|-------------------------------------------|
                    |                |         |  [28:0] = Value to write                  |
                    |     4          |   29    |    [29] = Not used (Don't Care)           |
                    |                |         | [31:30] = Field's offset                  |
                    |----------------|---------|-------------------------------------------|
                    |     5          |   30    |  [29:0] = Value to write                  |
                    |                |         | [31:30] = Field's offset                  |
                    |----------------|---------|-------------------------------------------|
                    |     6          |   31    |  [30:0] = Value to write                  |
                    |                |         |    [31] = Field's offset                  |
                    |----------------|---------|-------------------------------------------|
                    |     7   Gate   |  1 - 32 |  Write Data ignored (full mask)           |
                    +----------------+---------+-------------------------------------------+
                     (*) Number of 1's in Mask's msb = 32 - Field's width - Field's offset  
                    .</ipxact:description>
              <ipxact:bitOffset>3</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x1</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_write_delay</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_write_delay [8:4]</ipxact:displayName>
              <ipxact:description>Write Delay -  Set a delay for Write action
                    Set a delay in clock cycles for the write action in Write access
                    NOTE:  Self-Clear delay (if defined) will be started
                           after the write is executed.
                    .</ipxact:description>
              <ipxact:bitOffset>4</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x00</ipxact:value>
                  <ipxact:mask>0x1f</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>5</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_read_delay</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_read_delay [13:9]</ipxact:displayName>
              <ipxact:description>Read Delay -  Set a delay for Read action
                    Set a delay in clock cycles for the read action in Read access
                    NOTE:  Clear-On-Read delay (if defined) will be started
                           after the read is executed.
                    .</ipxact:description>
              <ipxact:bitOffset>9</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x00</ipxact:value>
                  <ipxact:mask>0x1f</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>5</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_self_clear_delay</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_self_clear_delay [18:14]</ipxact:displayName>
              <ipxact:description>Self Clear/Set Dealy - Disable or set a delay for Self-Clear/Set action
                    Set a delay, in clock cycles, for clearing RWSC bits or setting RWSS bits
                    in a Register, after a write operation.
                    If delay is set to 0 Self Clear/Set operation is disabled,
                    and clear/set may be executed manually
                    by asserting tfl_sec_acc_ctrl_man_self_clear.
                    .</ipxact:description>
              <ipxact:bitOffset>14</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x04</ipxact:value>
                  <ipxact:mask>0x1f</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>5</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_man_self_clear</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_man_self_clear [19:19]</ipxact:displayName>
              <ipxact:description>Manual Self Clear/Set - Clear/Set RWSC/RWSS bits manually
                    When this bit is asserted, RWSC bits and RWSS bits
                    are Clear/Set in all Registers.</ipxact:description>
              <ipxact:bitOffset>19</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_clear_on_read_delay</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_clear_on_read_delay [24:20]</ipxact:displayName>
              <ipxact:description>Clear/Set On Read Dealy - Disable or set a delay Clear-On-Read action
                    Set a delay, in clock cycles, for clearing/setting RWC/RWS/ROLH/ROLL bits
                    in a Register, after Read Access to the Register.
                    If delay is set to 0 Clear/Set On Read operation is disabled,
                    and clear/set may be executed manually by asserting
                    tfl_sec_acc_ctrl_man_clear_on_read.
                    .</ipxact:description>
              <ipxact:bitOffset>20</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x04</ipxact:value>
                  <ipxact:mask>0x1f</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>5</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_man_clear_on_read</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_man_clear_on_read [25:25]</ipxact:displayName>
              <ipxact:description>Manual Clear/Set On read - Clear/Set RWC/RWS/ROLH/ROLL bits manually
                    When this bit is asserted, RWC/RWS bits and ROLH/ROLL bits
                    are Clear/Set in all Registers.
                    .</ipxact:description>
              <ipxact:bitOffset>25</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x0</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_sec_acc_ctrl_access_ind_extend</ipxact:name>
              <ipxact:displayName>tfl_sec_acc_ctrl_access_ind_extend [30:26]</ipxact:displayName>
              <ipxact:description>Extend Write/Read Access indication pulse
                    Set width (clock cycles) for extension of Access Indication pulse.
                    .</ipxact:description>
              <ipxact:bitOffset>26</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x04</ipxact:value>
                  <ipxact:mask>0x1f</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>5</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_REG2PROBE_CTRL</ipxact:name>
            <ipxact:displayName>TFL_REG2PROBE_CTRL</ipxact:displayName>
            <ipxact:description>Reg2Probe Control Register for Section TFL
                The Reg2Probe Control Register can be used to enable/disable
                the Reg2Probe feature, and set the Reg2Probe address value.</ipxact:description>
            <ipxact:addressOffset>0x4</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:field>
              <ipxact:name>tfl_reg2probe_addr</ipxact:name>
              <ipxact:displayName>tfl_reg2probe_addr [10:0]</ipxact:displayName>
              <ipxact:description>Reg2Probe Address - Select Register address to output on Reg2Probe bus
                    The Reg2Probe address is valid when Sectionis not accessed,
                    and tfl_reg2probe_en is 1 (Reg2Probe enabled).
                    When Reg2Probe address is invalid, the Reg2Probe data bus
                    is driven to the constant 0xDEAD_FACE, which indicates
                    an invalid Reg2PRobe data.</ipxact:description>
              <ipxact:bitOffset>0</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x000</ipxact:value>
                  <ipxact:mask>0x7ff</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>11</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
            <ipxact:field>
              <ipxact:name>tfl_reg2probe_en</ipxact:name>
              <ipxact:displayName>tfl_reg2probe_en [31:31]</ipxact:displayName>
              <ipxact:description>Enable/Disable Reg2Probe feature
                    When Reg2Probe feature is enabled (1), the internal read data bus
                    and the Reg2Probe data bus are driven to the Register's value
                    that is selected by tfl_reg2probe_addr[10:0].
                    If it is disabled, the regular address bus is used
                    and the Reg2Probe data bus is driven to the constant 0xDEAD_FACE,
                    indicating invalid Reg2Probe data.</ipxact:description>
              <ipxact:bitOffset>31</ipxact:bitOffset>
              <ipxact:resets>
                <ipxact:reset>
                  <ipxact:value>0x1</ipxact:value>
                  <ipxact:mask>0x1</ipxact:mask>
                </ipxact:reset>
              </ipxact:resets>
              <ipxact:bitWidth>1</ipxact:bitWidth>
              <ipxact:access>read-write</ipxact:access>
            </ipxact:field>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_TX_GENERAL</ipxact:name>
            <ipxact:displayName>TFL_TX_GENERAL</ipxact:displayName>
            <ipxact:description>TFL TX general control</ipxact:description>
            <ipxact:addressOffset>0x8</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
          <ipxact:register>
            <ipxact:name>SERDES_SHIM_TFL_TFL_TX_CL72_GENERAL</ipxact:name>
