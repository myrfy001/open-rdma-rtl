          <ipxact:register>
            <ipxact:name>SERDES_LANE_DSP_DFE1_DSP_DFE1_ACCESS_CTRL</ipxact:name>
            <ipxact:displayName>DSP_DFE1_ACCESS_CTRL</ipxact:displayName>
            <ipxact:description>Access Control Register for Section DSP_DFE1
                The Access Control Register can be used to enable/disable and configure         
                the following access features to the Section registers:                         
                  + Soft Reset             -  Reset all RW Section's Registers (except this one)
                                              to their reset (default) values                   
                  + Load Preset Value      -  Load predefined Preset Value to selected Fields   
                  + Broadcast Mode         -  Enable/disable broadcast write mode               
                  + Field Mask Write (FMW) -  Enable/disable Field Mask Write feature           
                  + Write Delay            -  Set delay (clock cycles) for write access         
                  + Read Delay             -  Set delay (clock cycles) for read access          
                  + Self-Clear Delay       -  Disable or set delay (clock cycles)               
                                              of Self-Clear/Set action (affect RWSC/RWSS Fields)
                  + Manual Self-Clear      -  Manually Clear/Set RWSC/RWSS Fields               
                  + Clear On Read Delay    -  Disable or set delay (clock cycles)               
                                              of Clear/Set On Read action                       
                                              (affect RWC/RWS/ROLH/ROLL Fields)                 
                  + Manual Clear On Read   -  Manually Clear/Set RWC/RWS/ROLH/ROLL Fields</ipxact:description>
            <ipxact:addressOffset>0x94</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
          </ipxact:register>
