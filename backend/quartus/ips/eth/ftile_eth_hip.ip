            <ipxact:addressOffset>0x30</ipxact:addressOffset>
            <ipxact:size>32</ipxact:size>
            <ipxact:access>read-write</ipxact:access>
            <ipxact:field>
              <ipxact:name>cfg_bti_prot_enable</ipxact:name>
