          <ipxact:register>
            <ipxact:name>e25g_s11_rsfec_core_cfg</ipxact:name>
            <ipxact:description>RSFEC core 4-lane submodule configuration</ipxact:description>
            <ipxact:addressOffset>0x16c4</ipxact:addressOffset>
