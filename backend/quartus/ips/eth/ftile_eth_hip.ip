                <ipxact:bitWidth>32</ipxact:bitWidth>
                <ipxact:access>read-only</ipxact:access>
              </ipxact:field>
            </ipxact:register>
            <ipxact:register>
              <ipxact:name>rsfec_corr_1s_cnt_hi</ipxact:name>
