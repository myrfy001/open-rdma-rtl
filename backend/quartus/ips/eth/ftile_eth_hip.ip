                <ipxact:access>read-only</ipxact:access>
              </ipxact:field>
              <ipxact:field>
                <ipxact:name>cwbin3_stat</ipxact:name>
                <ipxact:description>Statistics value 3 Error.</ipxact:description>
                <ipxact:bitOffset>24</ipxact:bitOffset>
