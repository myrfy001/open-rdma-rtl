          </ipxact:register>
          <ipxact:register>
            <ipxact:name>e25g_s1_xcvrif_stat_hold_1</ipxact:name>
            <ipxact:description>xcvrif_stat_hold_1: TX FIFO Sticky flags - Write 1 to Clear</ipxact:description>
            <ipxact:addressOffset>0x314</ipxact:addressOffset>
