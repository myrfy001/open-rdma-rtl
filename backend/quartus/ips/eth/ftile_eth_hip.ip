              </ipxact:field>
              <ipxact:field>
                <ipxact:name>cwbin14_stat</ipxact:name>
                <ipxact:description>Statistics value 14 Error.</ipxact:description>
                <ipxact:bitOffset>16</ipxact:bitOffset>
                <ipxact:resets>
                  <ipxact:reset>
