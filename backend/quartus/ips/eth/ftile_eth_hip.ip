          <ipxact:register>
            <ipxact:name>e25g_s0_xcvrif_stat_inten_1</ipxact:name>
            <ipxact:description>xcvrif_stat_hold_1: TX FIFO Sticky flags - set to 1 to enable interrupt</ipxact:description>
